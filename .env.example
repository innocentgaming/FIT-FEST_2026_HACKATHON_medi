# ==============================================================================
# MediLink CARE - Environment Configuration Reference (.env.example)
# NOTE: Use placeholders only. Never commit production secrets.
# ==============================================================================

# Server Environment (development | production | test)
NODE_ENV=development
PORT=5000

# Security Secrets (Must be set to strong random strings in production)
JWT_SECRET=replace_with_long_random_jwt_secret_key_at_least_32_chars

# Demo Mode & Safety Safeguards
DEMO_INVENTORY_PIN=1234
ENABLE_DEMO_RESET=false
REQUIRE_STAFF_PIN=false

# Persistence Storage Path
DB_FILE_PATH=./src/db/data.json

# CORS Allowed Origins (Comma-separated or * for wildcard development)
ALLOWED_ORIGINS=https://fit-fest-2026-hackathon-medi.vercel.app,http://localhost:5173,http://localhost:3000
CLIENT_ORIGIN=https://fit-fest-2026-hackathon-medi.vercel.app

# Frontend Client Configuration (Vite)
VITE_API_URL=/api
VITE_SOCKET_URL=/

# Logging Level (debug | info | warn | error)
LOG_LEVEL=info
